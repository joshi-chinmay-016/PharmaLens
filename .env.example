# PharmaLens Environment Configuration Template
# Copy this file to .env and configure local values

# Groq API Configuration (Planned for Phase 2 - Not required for Phase 1)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://USER:PASSWORD@localhost:5432/pharmalens
DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@localhost:5432/pharmalens

# Server & CORS Configuration
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Storage Configuration
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=10
